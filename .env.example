# Global JWT Secret
JWT_SECRET=super_secret_jwt_microservices_2026
JWT_EXPIRES_IN=1d

# Ports
PORT_GATEWAY=8080
PORT_AUTH=5001
PORT_CUSTOMER=5002
PORT_PRODUCT=5003
PORT_ORDER=5004
PORT_SHIPMENT=5005

# Infrastructure URLs (Localhost)
REDIS_URL=redis://localhost:6379
KAFKA_BROKER=localhost:9092

# Database URLs (Database-per-Service)
AUTH_DB_URL=postgresql://postgres:postgres@localhost:5433/auth_db
CUSTOMER_DB_URL=postgresql://postgres:postgres@localhost:5433/customer_db
ORDER_DB_URL=postgresql://postgres:postgres@localhost:5433/order_db
PRODUCT_MONGO_URI=mongodb://localhost:27018/product_db
SHIPMENT_MONGO_URI=mongodb://localhost:27018/shipment_db

# Internal Service URLs for Service-to-Service communication
AUTH_SERVICE_URL=http://localhost:5001
CUSTOMER_SERVICE_URL=http://localhost:5002
PRODUCT_SERVICE_URL=http://localhost:5003
ORDER_SERVICE_URL=http://localhost:5004
SHIPMENT_SERVICE_URL=http://localhost:5005
